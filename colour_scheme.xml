<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for NINA, the fleet's caretaker: deep teal and mint.
  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#061110"/>  <!-- window / page background -->
  <colour name="panel"            value="#0B1C1A"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#173B36"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#102A26"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#E6F2EF"/>  <!-- primary text -->
  <colour name="text_sec"         value="#93ABA6"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#566E69"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#3FD9B4"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#8DF0D6"/>  <!-- lighter accent -->
  <colour name="accent2"          value="#2BA88B"/>  <!-- second accent -->
  <colour name="accent3"          value="#B6F5E4"/>  <!-- third accent -->

  <!-- States -->
  <colour name="warn"             value="#FFBE50"/>  <!-- slow, unexpected -->
  <colour name="problem"          value="#E0565B"/>  <!-- offline, rebooted -->
  <colour name="button_hover_bg"  value="#0F2724"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#2A1012"/>  <!-- danger button fill -->
</colour_scheme>
