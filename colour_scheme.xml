<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for NINA, sampled from images/nina_avatar.jpg.
  Avatar palette: a retro nurse in crimson on slate blue, red-cross red, warm cream.
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#080B0F"/>  <!-- window / page background -->
  <colour name="panel"            value="#10161C"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#26323C"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#18212A"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#F2EDE6"/>  <!-- primary text -->
  <colour name="text_sec"         value="#A39E9A"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#65686C"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#E45160"/>  <!-- logo, links, selected / hover: her red cross -->
  <colour name="accent_hover"     value="#EE8590"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#872840"/>  <!-- second avatar colour: her crimson dress -->
  <colour name="accent3"          value="#F5E1BF"/>  <!-- third avatar colour: warm cream -->
  <colour name="slate"            value="#5F767C"/>  <!-- her background slate -->

  <!-- States -->
  <colour name="ok"               value="#7FC8A9"/>  <!-- answering -->
  <colour name="warn"             value="#FFBE50"/>  <!-- slow, unexpected -->
  <colour name="problem"          value="#FF6B4A"/>  <!-- offline, rebooted -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#1C1216"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
